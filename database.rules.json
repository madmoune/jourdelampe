{
  "rules": {
    ".read": false,
    ".write": false,
    "quotes": {
      ".read": true,
      ".write": true,
      ".validate": "newData.hasChildren(['initialized', 'version']) && newData.child('initialized').val() === true && newData.child('version').val() === 2",
      "initialized": {
        ".validate": "newData.val() === true"
      },
      "items": {
        "$id": {
          ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,80}$/) && newData.hasChildren(['text', 'kind', 'active', 'createdAt', 'updatedAt'])",
          "text": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 140 && newData.val().matches(/.*[^ ].*/)"
          },
          "kind": {
            ".validate": "newData.val() === 'regular'"
          },
          "active": {
            ".validate": "newData.isBoolean()"
          },
          "href": {
            ".validate": "newData.isString() && newData.val().beginsWith('https://') && newData.val().length <= 2048"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "$other": {
        ".validate": false
      },
      "version": {
        ".validate": "newData.val() === 2"
      },
      "ai": {
        "$id": {
          ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,80}$/) && newData.hasChildren(['text', 'kind', 'active', 'createdAt', 'updatedAt'])",
          "text": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 140 && newData.val().matches(/.*[^ ].*/)"
          },
          "kind": {
            ".validate": "newData.val() === 'ai'"
          },
          "active": {
            ".validate": "newData.isBoolean()"
          },
          "href": {
            ".validate": "newData.isString() && newData.val().beginsWith('https://') && newData.val().length <= 2048"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "participants": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['name', 'updatedAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60 && newData.val().matches(/^[^ ]+( [^ ]+)*$/) && !newData.val().contains('\\t') && !newData.val().contains('\\r') && !newData.val().contains('\\n')"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "riddleProgress": {
      ".read": true,
      ".write": false
    },
    "potluck": {
      ".read": true,
      ".write": true,
      ".validate": "newData.hasChildren()",
      "$id": {
        ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,80}$/) && newData.hasChildren(['name', 'dish', 'active', 'createdAt', 'updatedAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60 && newData.val().matches(/.*[^ ].*/)"
        },
        "dish": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 160 && newData.val().matches(/.*[^ ].*/)"
        },
        "active": {
          ".validate": "newData.isBoolean()"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "game": {
      ".read": "auth != null && auth.token.gameAdmin === true",
      ".write": "auth != null && auth.token.gameAdmin === true",
      "catalog": {
        ".read": true,
        "$riddle": {
          ".validate": "$riddle.matches(/^[A-Za-z0-9_-]{1,128}$/) && newData.hasChildren(['title', 'prompt', 'order'])",
          "title": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100 && newData.val().matches(/.*[^ ].*/)"
          },
          "prompt": {
            ".validate": "newData.isString() && newData.val().length <= 10000"
          },
          "order": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "round": {
        ".read": true,
        ".validate": "newData.hasChildren(['id', 'resetAt'])",
        "id": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,128}$/)"
        },
        "resetAt": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      },
      "solves": {
        ".read": true,
        "$riddle": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && root.child('game/catalog/' + $riddle).exists() && root.child('participants/' + auth.uid + '/name').isString() && root.child('participants/' + auth.uid + '/name').val().length > 0 && newData.child('roundId').val() === root.child('game/round/id').val()",
            ".validate": "newData.hasChildren(['participantId', 'participantName', 'riddleId', 'riddleTitle', 'roundId', 'solvedAt']) && newData.parent().parent().parent().child('proofs/' + auth.uid + '/' + $riddle).child('answer').isString() && newData.parent().parent().parent().child('proofs/' + auth.uid + '/' + $riddle).child('answer').val() === root.child('riddleSecrets/' + $riddle + '/normalizedAnswer').val() && newData.parent().parent().parent().child('proofs/' + auth.uid + '/' + $riddle).child('roundId').val() === newData.child('roundId').val()",
            "participantId": {
              ".validate": "newData.val() === $uid"
            },
            "participantName": {
              ".validate": "newData.isString() && newData.val() === root.child('participants/' + $uid + '/name').val()"
            },
            "riddleId": {
              ".validate": "newData.val() === $riddle"
            },
            "riddleTitle": {
              ".validate": "newData.val() === root.child('game/catalog/' + $riddle + '/title').val()"
            },
            "roundId": {
              ".validate": "newData.val() === root.child('game/round/id').val()"
            },
            "solvedAt": {
              ".validate": "newData.isNumber() && newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "proofs": {
        "$uid": {
          "$riddle": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && newData.child('roundId').val() === root.child('game/round/id').val()",
            ".validate": "newData.hasChildren(['answer', 'roundId']) && newData.child('answer').isString() && newData.child('answer').val() === root.child('riddleSecrets/' + $riddle + '/normalizedAnswer').val() && newData.parent().parent().parent().child('solves/' + $riddle + '/' + auth.uid).child('participantId').val() === auth.uid && newData.parent().parent().parent().child('solves/' + $riddle + '/' + auth.uid).child('roundId').val() === newData.child('roundId').val()",
            "answer": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
            },
            "roundId": {
              ".validate": "newData.val() === root.child('game/round/id').val()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "$other": {
        ".validate": false
      }
    },
    "riddleSecrets": {
      ".read": "auth != null && auth.token.gameAdmin === true",
      ".write": "auth != null && auth.token.gameAdmin === true",
      "$riddle": {
        ".validate": "$riddle.matches(/^[A-Za-z0-9_-]{1,128}$/) && newData.hasChildren(['answer', 'normalizedAnswer'])",
        "answer": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
        },
        "normalizedAnswer": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200 && newData.val().matches(/^[A-Z0-9]+$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
